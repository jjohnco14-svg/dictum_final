use geom_lib

program main
    keep a as geom_lib.Point2D with no value
    set x of a to 0.0
    set y of a to 0.0
    keep b as geom_lib.Point2D with no value
    set x of b to 3.0
    set y of b to 4.0

    keep d as f32 with value 0.0
    call geom_lib.point_distance with a and b giving d
    print the text "distance=" and d

    keep severity as i32 with no value
    keep result as i32 with value 0
    call geom_lib.get_status with 7 and the address of severity giving result
    print the text "result=" and result and "severity=" and severity
end program
