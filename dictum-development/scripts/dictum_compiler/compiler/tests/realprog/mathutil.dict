module mathutil

    action square takes n as whole number produces whole number
        keep r as whole number with value 0
        put n times n into r
        return r
    end action

    action clamp takes v as whole number and lo as whole number and hi as whole number produces whole number
        keep out as whole number with value 0
        put v into out
        if out is less than lo then
            put lo into out
        end if
        if out is greater than hi then
            put hi into out
        end if
        return out
    end action

end module
